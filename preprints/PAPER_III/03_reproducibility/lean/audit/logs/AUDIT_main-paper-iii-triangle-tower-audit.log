TypedTriangle.TowerBounds.paperIIITriangleTowerHeight : ℕ → ℕ → ℕ → ℕ
TypedTriangle.Vortex.Explicit.paperIIITriangleTowerThreshold : ℝ → ℝ → ℝ → ℕ → ℕ → ℕ
@TypedTriangle.Vortex.Explicit.main_theorem_T_with_triangle_monitors_at_tower_order : ∀ {I : Type}
  (F : Set (Multiset I)) (α C η : ℝ) (h q : ℕ),
  0 < α →
    1 ≤ C →
      6 ≤ h →
        0 < η →
          ∀ {X : Type} [inst : Fintype X] (H : TypedTriangle.Host X I) (μ : Finset X → ℝ),
            TypedTriangle.Vortex.Explicit.paperIIITriangleTowerThreshold α C η h q ≤ Fintype.card X →
              TypedTriangle.IsDiffuseSeed H F C μ →
                TypedTriangle.IsPhysical H F (TypedTriangle.edges H) →
                  TypedTriangle.CommonNbrCond H F α →
                    TypedTriangle.HingeCond H F α h →
                      ∀ (ν : Type) [inst_1 : Fintype ν] (w : ν → Finset X → ℝ),
                        ↑(Fintype.card ν) ≤ ↑(Fintype.card X) ^ q →
                          (∀ (k : ν) (Q : Finset X), TypedTriangle.IsAllowed H F Q → |w k Q| ≤ 1) →
                            ∃ D,
                              TypedTriangle.IsDecomposition H F (TypedTriangle.edges H) D ∧
                                ∀ (k : ν),
                                  |∑ Q ∈ D, w k Q - ∑ Q ∈ TypedTriangle.allowed H F, μ Q * w k Q| ≤
                                    η * ↑(Fintype.card X) ^ 2
