module
public import RequestProject.S07V42.DeletionGeometry
public import RequestProject.S07V39.NativeRows
@[expose] public section

/-!
# V42 §2 — the fixed core, the intrinsic class group and the deleted kernels `K_Z`

Original finite host `H` on `V`, labels `lab`, types `F`; a fixed core `W : Finset V`.

* `indG H U` — the ambient zero extension of the induced host `H[U]` (vertices outside `U` are
  isolated). It is used ONLY for integer edge coordinates: no H3 is claimed for it. Its true
  induced host is `H.comap (Subtype.val : {x // x ∈ U} → V)` (`indG_comap`).
* `LamCore H lab F W = Λ(H[W])` lifted to `V` (fixed, intrinsic core lattice);
  `ClassQ = (Sym2 V → ℤ) ⧸ LamCore` (all ambient integer edge vectors modulo `Λ_core`).
* `wQ e = [1_e]`, `chargeQ Y = ∑_{e∈Y} wQ e = [1_Y]` (`chargeQ_eq`): charge is edge-additive.
* `MZ H lab F W Z = M(H[W \ Z])` lifted to `V` (actual local profile module),
  `LamDel H lab F Z = Λ(H − Z)` (= `Λ(H[V \ Z])` lifted, `S07V39.delG`).
* `KZ H lab F W Z = image in ClassQ of MZ ∩ LamDel` (`mem_KZ`).
* `KZ_antitone`: `Z ⊆ Z' → K_{Z'} ≤ K_Z` (the denominator stays the fixed `Λ_core`).
* `lamDel_eq_span`: membership in `Λ(H − Z)` is generated by allowed triangles of `H` avoiding
  `Z` — physicality in `H \ Z` itself, not in `H`.
-/

open Finset Classical Submodule

noncomputable section

namespace S07V42

open TypedTriangle.SparseEdge TypedTriangle.ComponentRows TypedTriangle.Composition
open TypedTriangle.Dispersal

variable {V I : Type*} [Fintype V]

/-- ambient zero extension of the induced host `H[U]` (coordinates only) -/
def indG (H : SimpleGraph V) (U : Finset V) : SimpleGraph V where
  Adj x y := H.Adj x y ∧ x ∈ U ∧ y ∈ U
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.2, h.2.1⟩⟩
  loopless := ⟨fun _ h => H.loopless.irrefl _ h.1⟩

omit [Fintype V] in
lemma indG_le (H : SimpleGraph V) (U : Finset V) : indG H U ≤ H := fun _ _ h => h.1

omit [Fintype V] in
lemma indG_mono (H : SimpleGraph V) {U U' : Finset V} (h : U ⊆ U') : indG H U ≤ indG H U' :=
  fun _ _ hx => ⟨hx.1, h hx.2.1, h hx.2.2⟩

omit [Fintype V] in
/-- the true induced host of `indG H U` on the subtype `U` is `H[U]` -/
lemma indG_comap (H : SimpleGraph V) (U : Finset V) :
    (indG H U).comap (Subtype.val : {x // x ∈ U} → V) = H.comap Subtype.val := by
  ext a b
  simp only [SimpleGraph.comap_adj, indG]
  exact ⟨fun h => h.1, fun h => ⟨h, a.2, b.2⟩⟩

omit [Fintype V] in
lemma edgesIn_indG (H : SimpleGraph V) (U : Finset V) :
    EdgesIn (indG H U) (Subtype.val : {x // x ∈ U} → V) :=
  fun a _ h => ⟨⟨a, h.2.1⟩, rfl⟩

omit [Fintype V] in
lemma indG_le_delG (H : SimpleGraph V) {U Z : Finset V} (h : Disjoint U Z) :
    indG H U ≤ S07V39.delG H Z := fun _ _ hx =>
  ⟨hx.1, Finset.disjoint_left.1 h hx.2.1, Finset.disjoint_left.1 h hx.2.2⟩

variable (H : SimpleGraph V) (lab : V → I) (F : Set (Multiset I)) (W : Finset V)

/-- the fixed intrinsic core lattice `Λ(H[W])`, zero-extended to `V` -/
def LamCore : Submodule ℤ (Sym2 V → ℤ) := lattice (indG H W) lab F

/-- the core local profile module `M(H[W])`, zero-extended to `V` -/
def MCore : Submodule ℤ (Sym2 V → ℤ) := localProfile (indG H W) lab F

/-- the class group `Q = (Sym2 V → ℤ) / Λ_core` -/
abbrev ClassQ := (Sym2 V → ℤ) ⧸ LamCore H lab F W

/-- the class of the unit indicator of an edge -/
def wQ (e : Sym2 V) : ClassQ H lab F W := Submodule.Quotient.mk (ind {e})

/-- the class of an ambient vector -/
def clsQ (x : Sym2 V → ℤ) : ClassQ H lab F W := Submodule.Quotient.mk x

/-- edge-additive charge -/
def chargeQ (Y : Finset (Sym2 V)) : ClassQ H lab F W := ∑ e ∈ Y, wQ H lab F W e

omit [Fintype V] in
lemma ind_eq_sum (Y : Finset (Sym2 V)) : ind Y = ∑ e ∈ Y, ind {e} := by
  funext f
  simp only [ind, Finset.sum_apply, Finset.mem_singleton]
  rw [Finset.sum_ite_eq]

omit [Fintype V] in
/-- **charge is edge-additive**: `chargeQ Y = [1_Y]` -/
lemma chargeQ_eq (Y : Finset (Sym2 V)) : chargeQ H lab F W Y = clsQ H lab F W (ind Y) := by
  unfold chargeQ clsQ wQ
  rw [ind_eq_sum]
  show _ = (LamCore H lab F W).mkQ _
  rw [map_sum]
  rfl

/-- the deleted local module `M(H[W \ Z])`, zero-extended to `V` -/
def MZ (Z : Finset V) : Submodule ℤ (Sym2 V → ℤ) := localProfile (indG H (W \ Z)) lab F

/-- the deleted physical lattice `Λ(H − Z)` (`= Λ(H[V \ Z])` zero-extended) -/
def LamDel (Z : Finset V) : Submodule ℤ (Sym2 V → ℤ) := lattice (S07V39.delG H Z) lab F

/-- the deleted kernel `K_Z ≤ Q`: the image of `M(H[W \ Z]) ∩ Λ(H − Z)` -/
def KZ (Z : Finset V) : Submodule ℤ (ClassQ H lab F W) :=
  (MZ H lab F W Z ⊓ LamDel H lab F Z).map (LamCore H lab F W).mkQ

lemma mem_KZ {Z : Finset V} {k : ClassQ H lab F W} :
    k ∈ KZ H lab F W Z ↔
      ∃ x, x ∈ MZ H lab F W Z ∧ x ∈ LamDel H lab F Z ∧ clsQ H lab F W x = k := by
  unfold KZ clsQ
  simp only [Submodule.mem_map, Submodule.mem_inf, Submodule.mkQ_apply]
  constructor
  · rintro ⟨x, ⟨h1, h2⟩, rfl⟩; exact ⟨x, h1, h2, rfl⟩
  · rintro ⟨x, h1, h2, rfl⟩; exact ⟨x, ⟨h1, h2⟩, rfl⟩

lemma MZ_le_MCore (Z : Finset V) : MZ H lab F W Z ≤ MCore H lab F W :=
  S07V37.localProfile_mono (indG_mono H Finset.sdiff_subset) lab F

lemma MZ_le_MDel (Z : Finset V) :
    MZ H lab F W Z ≤ localProfile (S07V39.delG H Z) lab F :=
  S07V37.localProfile_mono (indG_le_delG H Finset.sdiff_disjoint) lab F

/-- **`K_Z` is antitone in `Z`.** -/
theorem KZ_antitone {Z Z' : Finset V} (h : Z ⊆ Z') : KZ H lab F W Z' ≤ KZ H lab F W Z := by
  apply Submodule.map_mono
  apply inf_le_inf
  · exact S07V37.localProfile_mono (indG_mono H (Finset.sdiff_subset_sdiff subset_rfl h)) lab F
  · apply S07V37.lattice_mono
    intro x y hxy
    exact ⟨hxy.1, fun hx => hxy.2.1 (h hx), fun hy => hxy.2.2 (h hy)⟩

omit [Fintype V] in
/-- **Physicality in `H \ Z` itself**: `Λ(H − Z)` is spanned by the indicators of the allowed
triangles of the ORIGINAL `H` that avoid every vertex of `Z`. -/
theorem lamDel_eq_span (Z : Finset V) :
    LamDel H lab F Z = span ℤ ((fun T => ind (triEdges T)) ''
      {T | IsAllowed H lab F T ∧ ∀ x ∈ T, x ∉ Z}) := by
  unfold LamDel lattice
  congr 2
  ext T
  exact S07V39.allowed_delG_iff

end S07V42
