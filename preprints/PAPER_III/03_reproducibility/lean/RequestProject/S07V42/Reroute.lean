module
public import RequestProject.S07V34.Box
public import RequestProject.S07V37.RelativeKernel
@[expose] public section

/-!
# V42 §5 — bounded actual representatives through V34 bounded-box payment (abstract)

`bounded_representative (d R k)`: there is `U` (depending only on `d, R, k`) such that for any
ℓ¹-like size `ℓ` on an abelian group `N`, any subgroup `P` (the "physical" part, e.g.
`M ∩ L`), any additive coordinate map `q : N → ℤ^d`, any relation set `S ⊆ [-R, R]^d` and any
finite `Y ⊆ P` with `ℓ ≤ k` and `q(Y) ⊆ [-R, R]^d`: every `b ∈ [-R, R]^d` whose class lies in
the subgroup generated by the classes of `q(Y)` has an ACTUAL representative `x ∈ P` with
`ℓ x ≤ U` and `[q x] = [b]` in `ℤ^d / ⟨S⟩`.

Proof: V34 `uniform_monitor_payment_box` with `D = ∅` (so `Hgrp S ∅ = ⊥`); the monitor value on
`b` is bounded by `M`; the word has length `≤ A (1 + M)`; one physical preimage per coordinate
is chosen and the negated word is summed. No saturation, bounded ambient rank, or count of `Y`
is used; torsion of `ℤ^d / ⟨S⟩` is paid by the monitor.
-/

open Finset Classical

noncomputable section

namespace S07V42

open S07V34 S07V32

lemma Hgrp_empty {d : ℕ} (S : Finset (Fin d → ℤ)) : Hgrp S ∅ = ⊥ := by
  simp [Hgrp]

lemma qmk_hom {d : ℕ} (S : Finset (Fin d → ℤ)) (v : Fin d → ℤ) :
    qmk S v = (QuotientAddGroup.mk' (AddSubgroup.closure (S : Set (Fin d → ℤ)))) v := rfl

/-- the uniform bound of `bounded_representative` -/
def repU (A M k : ℕ) : ℕ := A * (1 + M) * k

universe u

/-- **Bounded actual representatives (abstract V34 payment).** -/
theorem bounded_representative (d R k : ℕ) :
    ∃ U : ℕ, ∀ {N : Type u} [AddCommGroup N] (ℓ : N → ℤ), S07V37.L1Like ℓ →
      ∀ (P : AddSubgroup N) (q : N →+ (Fin d → ℤ)) (S : Finset (Fin d → ℤ)),
      (∀ s ∈ S, ∀ i, |s i| ≤ R) → ∀ Y : Finset N,
      (∀ y ∈ Y, y ∈ P ∧ ℓ y ≤ k ∧ ∀ i, |q y i| ≤ R) →
      ∀ b : Fin d → ℤ, (∀ i, |b i| ≤ R) → qmk S b ∈ Kgrp S (Y.image q) →
      ∃ x ∈ P, ℓ x ≤ U ∧ qmk S (q x) = qmk S b := by
  obtain ⟨A, M, hAM⟩ := uniform_monitor_payment_box d R
  refine ⟨repU A M k, ?_⟩
  intro N _ ℓ hℓ P q S hS Y hY b hb hbK
  obtain ⟨kk, psi, -, hM, hpay⟩ := hAM S ∅ hS (by simp)
  have hC : ∀ v ∈ Y.image q, ∀ i, |v i| ≤ R := by
    intro v hv i
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hv
    exact (hY y hy).2.2 i
  obtain ⟨z, hz, hzb⟩ := hpay (Y.image q) hC (qmk S b) hbK
  rw [Hgrp_empty, AddSubgroup.mem_bot] at hz
  have hMb := hM b hb
  -- choose preimages
  have hpre : ∀ c : (Y.image q), ∃ y ∈ Y, q y = c := fun c => Finset.mem_image.1 c.2
  choose yc hyc hqyc using hpre
  refine ⟨-∑ c : (Y.image q), z c • yc c, ?_, ?_, ?_⟩
  · exact P.neg_mem (P.sum_mem fun c _ => P.zsmul_mem (hY _ (hyc c)).1 _)
  · have hneg : ℓ (-∑ c : (Y.image q), z c • yc c) ≤ ℓ (∑ c : (Y.image q), z c • yc c) := by
      have := hℓ.smul_le (-1) (∑ c : (Y.image q), z c • yc c)
      simpa using this
    refine hneg.trans ((hℓ.sum_le _ _ _).trans ?_)
    have h1 : ∑ c : (Y.image q), |z c| * ℓ (yc c) ≤ ∑ c : (Y.image q), |z c| * k :=
      Finset.sum_le_sum fun c _ =>
        mul_le_mul_of_nonneg_left (hY _ (hyc c)).2.1 (abs_nonneg _)
    refine h1.trans ?_
    rw [← Finset.sum_mul]
    have hk : (0 : ℤ) ≤ k := Nat.cast_nonneg k
    have h2 : (A : ℤ) * (1 + l1 (psi ((qmk S b : Qt S) : Qt S ⧸ Hgrp S ∅))) ≤ A * (1 + M) :=
      mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg A)
    calc (∑ c : (Y.image q), |z c|) * k ≤ (A * (1 + M) : ℤ) * k :=
          mul_le_mul_of_nonneg_right (hzb.trans h2) hk
      _ = (repU A M k : ℤ) := by unfold repU; push_cast; ring
  · rw [qmk_hom, map_neg, map_sum]
    simp only [map_zsmul, hqyc]
    have : qmk S b = -∑ c : (Y.image q), z c • qmk S (c : Fin d → ℤ) :=
      eq_neg_of_add_eq_zero_left hz
    rw [this, map_neg, map_sum]
    simp only [map_zsmul]
    rfl

end S07V42
