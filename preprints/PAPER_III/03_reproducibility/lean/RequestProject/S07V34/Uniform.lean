module
public import RequestProject.S07V34.Monitor
@[expose] public section

/-!
# Uniform monitors and integer payment from a bounded finite presentation (V34, part 3)

Fix `d : ℕ` and a finite set `B ⊆ ℤ^d`. A configuration is `(S, C, D)` with `S, C, D ⊆ B`:
* `Qt S = ℤ^d ⧸ ⟨S⟩` (integer span),
* `Kgrp S C ⊆ Qt S` generated by the images of `C`,
* `Hgrp S D ⊆ Qt S` generated by the images of `D`.

`uniform_monitor_payment` gives constants `A M : ℕ`, fixed before the configuration, such that
for each `(S, D)` there is ONE integer monitor `ψ : Qt S ⧸ Hgrp S D →+ ℤ^k` (independent of `C`)
with finite kernel, `‖ψ(b)‖₁ ≤ M` for every `b ∈ B`, and for every `C ⊆ B` and every `x ∈ K`
an integer word `z : C → ℤ` with `x + ∑ z c • c ∈ H` and `∑ |z c| ≤ A * (1 + ‖ψ(x+H)‖₁)`.
The hypothesis `H ≤ K` of the informal statement is not needed and is not assumed (the theorem
is stronger); `uniform_monitor_payment_of_le` records the form with it.
-/

namespace S07V34

open Finset S07V32

variable {d : ℕ}

/-- `Q = ℤ^d ⧸ ⟨S⟩`. -/
abbrev Qt (S : Finset (Fin d → ℤ)) : Type :=
  (Fin d → ℤ) ⧸ AddSubgroup.closure (S : Set (Fin d → ℤ))

/-- Image of a vector of `ℤ^d` in `Q = ℤ^d ⧸ ⟨S⟩`. -/
def qmk (S : Finset (Fin d → ℤ)) (v : Fin d → ℤ) : Qt S := QuotientAddGroup.mk v

/-- `K`: subgroup of `Q` generated by the images of `C`. -/
def Kgrp (S C : Finset (Fin d → ℤ)) : AddSubgroup (Qt S) :=
  AddSubgroup.closure (qmk S '' (C : Set (Fin d → ℤ)))

/-- `H`: subgroup of `Q` generated by the images of `D`. -/
def Hgrp (S D : Finset (Fin d → ℤ)) : AddSubgroup (Qt S) :=
  AddSubgroup.closure (qmk S '' (D : Set (Fin d → ℤ)))

instance (S D : Finset (Fin d → ℤ)) : AddGroup.FG (Qt S ⧸ Hgrp S D) := by
  have : AddGroup.FG (Fin d → ℤ) := inferInstance
  have h1 : AddGroup.FG (Qt S) := QuotientAddGroup.fg _
  exact QuotientAddGroup.fg _

lemma Kgrp_eq_closure_range (S C : Finset (Fin d → ℤ)) :
    Kgrp S C = AddSubgroup.closure (Set.range fun c : C => qmk S (c : Fin d → ℤ)) := by
  rw [Kgrp, Set.image_eq_range]; rfl

/-- Per-configuration payment for a fixed monitor (constant depending on the configuration). -/
lemma config_payment (S C D : Finset (Fin d → ℤ)) {k : ℕ}
    (psi : Qt S ⧸ Hgrp S D →+ (Fin k → ℤ)) (hker : (psi.ker : Set (Qt S ⧸ Hgrp S D)).Finite) :
    ∃ A : ℕ, ∀ x ∈ Kgrp S C, ∃ z : C → ℤ,
      x + ∑ c : C, z c • qmk S (c : Fin d → ℤ) ∈ Hgrp S D ∧
        ∑ c : C, |z c| ≤ (A : ℤ) * (1 + l1 (psi (x : Qt S ⧸ Hgrp S D))) := by
  obtain ⟨A, hA⟩ := restricted_payment (Hgrp S D) (fun c : C => qmk S (c : Fin d → ℤ)) psi hker
  exact ⟨A, fun x hx => hA x (by rwa [← Kgrp_eq_closure_range])⟩

/-- A finite family of naturals has a common upper bound (its sum). -/
lemma exists_bound_finset {α : Type*} (T : Finset α) (f : α → ℕ) : ∃ N : ℕ, ∀ t ∈ T, f t ≤ N :=
  ⟨∑ t ∈ T, f t, fun _ ht => single_le_sum (fun _ _ => Nat.zero_le _) ht⟩

/-- **Uniform monitor and integer payment (main theorem).** The constants `A` and `M` are
chosen from `d` and `B` only, before the configuration. For each `(S, D)` the monitor is chosen
before `C`. -/
theorem uniform_monitor_payment (d : ℕ) (B : Finset (Fin d → ℤ)) :
    ∃ A M : ℕ, ∀ S D : Finset (Fin d → ℤ), S ⊆ B → D ⊆ B →
      ∃ (k : ℕ) (psi : Qt S ⧸ Hgrp S D →+ (Fin k → ℤ)),
        (psi.ker : Set (Qt S ⧸ Hgrp S D)).Finite ∧
        (∀ b ∈ B, l1 (psi ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D)) ≤ M) ∧
        ∀ C : Finset (Fin d → ℤ), C ⊆ B → ∀ x ∈ Kgrp S C, ∃ z : C → ℤ,
          x + ∑ c : C, z c • qmk S (c : Fin d → ℤ) ∈ Hgrp S D ∧
            ∑ c : C, |z c| ≤ (A : ℤ) * (1 + l1 (psi (x : Qt S ⧸ Hgrp S D))) := by
  classical
  choose k psi hker using fun (S D : Finset (Fin d → ℤ)) => exists_int_monitor (Qt S ⧸ Hgrp S D)
  choose Af hAf using fun (S C D : Finset (Fin d → ℤ)) => config_payment S C D (psi S D) (hker S D)
  obtain ⟨Atot, hAtot⟩ := exists_bound_finset (B.powerset ×ˢ B.powerset ×ˢ B.powerset)
    (fun t => Af t.1 t.2.1 t.2.2)
  obtain ⟨Mtot, hMtot⟩ := exists_bound_finset (B.powerset ×ˢ B.powerset)
    (fun t => ∑ b ∈ B, (l1 (psi t.1 t.2 ((qmk t.1 b : Qt t.1) : Qt t.1 ⧸ Hgrp t.1 t.2))).toNat)
  refine ⟨Atot, Mtot, fun S D hS hD => ⟨k S D, psi S D, hker S D, ?_, ?_⟩⟩
  · intro b hb
    have h1 : (l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))) ≤
        ((l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat : ℤ) := Int.self_le_toNat _
    have h2 : (l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat ≤
        ∑ b ∈ B, (l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat :=
      single_le_sum (f := fun b => (l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat)
        (fun _ _ => Nat.zero_le _) hb
    have h3 := hMtot (S, D) (mem_product.mpr ⟨mem_powerset.mpr hS, mem_powerset.mpr hD⟩)
    have h4 : (l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat ≤ Mtot := h2.trans h3
    have h5 : ((l1 (psi S D ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D))).toNat : ℤ) ≤ (Mtot : ℤ) :=
      Int.ofNat_le.mpr h4
    exact h1.trans h5
  · intro C hC x hx
    obtain ⟨z, hz, hb⟩ := hAf S C D x hx
    refine ⟨z, hz, hb.trans ?_⟩
    have hle : Af S C D ≤ Atot := hAtot (S, C, D)
        (mem_product.mpr ⟨mem_powerset.mpr hS,
          mem_product.mpr ⟨mem_powerset.mpr hC, mem_powerset.mpr hD⟩⟩)
    have h0 : (0 : ℤ) ≤ 1 + l1 (psi S D (x : Qt S ⧸ Hgrp S D)) := by
      linarith [l1_nonneg (psi S D (x : Qt S ⧸ Hgrp S D))]
    exact mul_le_mul_of_nonneg_right (Int.ofNat_le.mpr hle) h0

/-- The literal form of the request: configurations with `H ≤ K`, quantifiers
`∃ A M, ∀ (S, C, D), H ≤ K → ∃ k ψ, …` (the monitor may here depend on `C` too; the main
theorem gives the stronger choice independent of `C` and does not need `H ≤ K`). -/
theorem uniform_monitor_payment_of_le (d : ℕ) (B : Finset (Fin d → ℤ)) :
    ∃ A M : ℕ, ∀ S C D : Finset (Fin d → ℤ), S ⊆ B → C ⊆ B → D ⊆ B →
      Hgrp S D ≤ Kgrp S C →
      ∃ (k : ℕ) (psi : Qt S ⧸ Hgrp S D →+ (Fin k → ℤ)),
        (psi.ker : Set (Qt S ⧸ Hgrp S D)).Finite ∧
        (∀ b ∈ B, l1 (psi ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D)) ≤ M) ∧
        ∀ x ∈ Kgrp S C, ∃ z : C → ℤ,
          x + ∑ c : C, z c • qmk S (c : Fin d → ℤ) ∈ Hgrp S D ∧
            ∑ c : C, |z c| ≤ (A : ℤ) * (1 + l1 (psi (x : Qt S ⧸ Hgrp S D))) := by
  obtain ⟨A, M, h⟩ := uniform_monitor_payment d B
  refine ⟨A, M, fun S C D hS hC hD _ => ?_⟩
  obtain ⟨k, psi, hk, hM, hpay⟩ := h S D hS hD
  exact ⟨k, psi, hk, hM, hpay C hC⟩

/-- Variant with coefficients indexed by all of `B`, zero outside `C`. -/
theorem uniform_monitor_payment_indexB (d : ℕ) (B : Finset (Fin d → ℤ)) :
    ∃ A M : ℕ, ∀ S D : Finset (Fin d → ℤ), S ⊆ B → D ⊆ B →
      ∃ (k : ℕ) (psi : Qt S ⧸ Hgrp S D →+ (Fin k → ℤ)),
        (psi.ker : Set (Qt S ⧸ Hgrp S D)).Finite ∧
        (∀ b ∈ B, l1 (psi ((qmk S b : Qt S) : Qt S ⧸ Hgrp S D)) ≤ M) ∧
        ∀ C : Finset (Fin d → ℤ), C ⊆ B → ∀ x ∈ Kgrp S C, ∃ z : (Fin d → ℤ) → ℤ,
          (∀ b, b ∉ C → z b = 0) ∧
          x + ∑ b ∈ B, z b • qmk S b ∈ Hgrp S D ∧
            ∑ b ∈ B, |z b| ≤ (A : ℤ) * (1 + l1 (psi (x : Qt S ⧸ Hgrp S D))) := by
  classical
  obtain ⟨A, M, h⟩ := uniform_monitor_payment d B
  refine ⟨A, M, fun S D hS hD => ?_⟩
  obtain ⟨k, psi, hk, hM, hpay⟩ := h S D hS hD
  refine ⟨k, psi, hk, hM, fun C hC x hx => ?_⟩
  obtain ⟨z, hz, hb⟩ := hpay C hC x hx
  let w : (Fin d → ℤ) → ℤ := fun b => if h : b ∈ C then z ⟨b, h⟩ else 0
  have hsum : ∀ f : ℤ → Qt S → Qt S, (∀ q, f 0 q = 0) →
      ∑ b ∈ B, f (w b) (qmk S b) = ∑ c : C, f (z c) (qmk S c) := by
    intro f hf0
    rw [← sum_subset hC (fun b _ hbC => by simp [w, hbC, hf0]), ← sum_coe_sort C]
    exact sum_congr rfl fun c _ => by simp [w, c.2]
  refine ⟨w, fun b hb => by simp [w, hb], ?_, ?_⟩
  · rw [hsum (fun a q => a • q) (fun q => zero_smul ℤ q)]; exact hz
  · have : ∑ b ∈ B, |w b| = ∑ c : C, |z c| := by
      rw [← sum_subset hC (fun b _ hbC => by simp [w, hbC]), ← sum_coe_sort C]
      exact sum_congr rfl fun c _ => by simp [w, c.2]
    rw [this]; exact hb

end S07V34
