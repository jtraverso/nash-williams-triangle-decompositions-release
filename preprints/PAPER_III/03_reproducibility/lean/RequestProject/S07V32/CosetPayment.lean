module
public import Mathlib
@[expose] public section

/-!
# Integer coset payment modulo a conserved-charge subgroup (V32)

Reusable algebra lemma for the G3 bank (not a host hypothesis).

* `l1 v = ∑ i, |v i|`: the integer `ℓ¹` norm of an integer vector.
* `l1_bound_linear`: every `ℤ`-linear map between finite coordinate lattices is `ℓ¹`-bounded.
* `lattice_preimage_bound`: for an integer matrix `P : ℤ^m → ℤ^d` there is `C` such that every
  `y ∈ range P` has an integer preimage of `ℓ¹` norm `≤ C * ‖y‖₁` (via Smith normal form).
* `coset_payment_abstract`: `Q` generated by `gb`, `ψ : Q →+ ℤ^d` with finite kernel ⇒ every `q`
  is an integer word `∑ zᵢ • gbᵢ` with `∑ |zᵢ| ≤ A * (1 + ∑ |ψ q j|)`.
* `coset_payment`: the quotient form `x + ∑ zᵢ • gᵢ ∈ H`, with `g` generating `G` modulo `H`.
* `coset_payment_of_generate`: same with `g` generating `G`.
* `coset_payment_family`: one common `A` for a finite family of configurations.
* `coset_payment_torsion_example`: the lemma applies with nontrivial torsion and `ψ = 0`.
* `not_coset_payment_infinite_kernel`: the finite-kernel hypothesis cannot be dropped.
-/

namespace S07V32

open Finset

/-- Integer `ℓ¹` norm of an integer vector indexed by a finite type. -/
def l1 {α : Type*} [Fintype α] (v : α → ℤ) : ℤ := ∑ i, |v i|

lemma l1_nonneg {α : Type*} [Fintype α] (v : α → ℤ) : 0 ≤ l1 v :=
  sum_nonneg fun _ _ => abs_nonneg _

lemma l1_add_le {α : Type*} [Fintype α] (v w : α → ℤ) : l1 (v + w) ≤ l1 v + l1 w := by
  unfold l1
  rw [← sum_add_distrib]
  exact sum_le_sum fun i _ => abs_add_le _ _

/-- Every `ℤ`-linear map between finite coordinate lattices is bounded in `ℓ¹`. -/
theorem l1_bound_linear {α β : Type*} [Fintype α] [Fintype β] [DecidableEq α]
    (T : (α → ℤ) →ₗ[ℤ] (β → ℤ)) : ∃ K : ℕ, ∀ y, l1 (T y) ≤ K * l1 y := by
  set v : α → β → ℤ := fun j => T (Pi.single j 1) with hv
  set S : ℤ := ∑ j, l1 (v j) with hS
  have hS0 : 0 ≤ S := sum_nonneg fun j _ => l1_nonneg _
  refine ⟨S.toNat, fun y => ?_⟩
  rw [Int.toNat_of_nonneg hS0]
  have hy : T y = ∑ j, y j • v j := by
    conv_lhs => rw [pi_eq_sum_univ' y]
    simp only [hv, map_sum, map_smul]
  calc l1 (T y) = ∑ i, |∑ j, y j * v j i| := by simp [l1, hy, Finset.sum_apply]
    _ ≤ ∑ i, ∑ j, |y j| * |v j i| :=
        sum_le_sum fun i _ => (abs_sum_le_sum_abs _ _).trans (by simp [abs_mul])
    _ = ∑ j, |y j| * l1 (v j) := by rw [sum_comm]; simp [l1, mul_sum]
    _ ≤ ∑ j, |y j| * S := sum_le_sum fun j _ =>
        mul_le_mul_of_nonneg_left
          (single_le_sum (f := fun j => l1 (v j)) (fun j _ => l1_nonneg _) (mem_univ j))
          (abs_nonneg _)
    _ = S * l1 y := by rw [l1, mul_sum]; exact sum_congr rfl fun j _ => mul_comm _ _

/-- Integer preimages with linearly bounded `ℓ¹` norm (Smith normal form of `range P`). -/
theorem lattice_preimage_bound {m d : ℕ} (P : (Fin m → ℤ) →ₗ[ℤ] (Fin d → ℤ)) :
    ∃ C : ℕ, ∀ z0, ∃ z, P z = P z0 ∧ l1 z ≤ C * l1 (P z0) := by
  obtain ⟨n, snf⟩ := (LinearMap.range P).smithNormalForm (Pi.basisFun ℤ (Fin d))
  have hu : ∀ i, ∃ u, P u = (snf.bN i : Fin d → ℤ) := fun i => (snf.bN i).2
  choose u hu using hu
  let U : (Fin n → ℤ) →ₗ[ℤ] (Fin m → ℤ) := Fintype.linearCombination ℤ u
  let R : (Fin d → ℤ) →ₗ[ℤ] (Fin d → ℤ) :=
    (Finsupp.linearEquivFunOnFinite ℤ ℤ (Fin d)).toLinearMap ∘ₗ snf.bM.repr.toLinearMap
  obtain ⟨K1, hK1⟩ := l1_bound_linear U
  obtain ⟨K2, hK2⟩ := l1_bound_linear R
  refine ⟨K1 * K2, fun z0 => ?_⟩
  let y : LinearMap.range P := ⟨P z0, z0, rfl⟩
  let c : Fin n → ℤ := snf.bN.repr y
  refine ⟨U c, ?_, ?_⟩
  · have h1 : P (U c) = ∑ i, c i • (snf.bN i : Fin d → ℤ) := by
      simp only [U, Fintype.linearCombination_apply, map_sum, map_smul, hu]
    have h2 := congrArg Subtype.val (snf.bN.sum_repr y)
    rw [Submodule.coe_sum] at h2
    rw [h1]
    exact h2
  · have ha : ∀ i, snf.a i ≠ 0 := by
      intro i hi
      have := snf.snf i
      rw [hi, zero_smul] at this
      exact snf.bN.ne_zero i (Subtype.ext this)
    have hRy : ∀ i, R (P z0) (snf.f i) = snf.a i * c i := by
      intro i
      have := congrFun (snf.repr_comp_embedding_eq_smul y) i
      simpa [R, c, y] using this
    have hc : l1 c ≤ l1 (R (P z0)) := by
      calc l1 c = ∑ i, |c i| := rfl
        _ ≤ ∑ i, |R (P z0) (snf.f i)| := sum_le_sum fun i _ => by
            rw [hRy, abs_mul]
            have : 1 ≤ |snf.a i| := Int.one_le_abs (ha i)
            nlinarith [abs_nonneg (c i)]
        _ = ∑ k ∈ univ.map snf.f, |R (P z0) k| := by rw [sum_map]
        _ ≤ ∑ k, |R (P z0) k| :=
            sum_le_sum_of_subset_of_nonneg (subset_univ _) fun _ _ _ => abs_nonneg _
        _ = l1 (R (P z0)) := rfl
    calc l1 (U c) ≤ K1 * l1 c := hK1 c
      _ ≤ K1 * (K2 * l1 (P z0)) :=
          mul_le_mul_of_nonneg_left (hc.trans (hK2 _)) (by positivity)
      _ = ((K1 * K2 : ℕ) : ℤ) * l1 (P z0) := by push_cast; ring

/-- **Integer coset payment, abstract form.** If `gb` generates `Q` (every `q` is an integer
word in `gb`) and `ψ : Q →+ ℤ^d` has finite kernel, then there is a natural constant `A`, depending
only on `Q, gb, ψ`, such that every `q` is an integer word `∑ zᵢ • gbᵢ` with
`∑ |zᵢ| ≤ A * (1 + ∑ⱼ |ψ q j|)`. -/
theorem coset_payment_abstract {Q : Type*} [AddCommGroup Q] {m d : ℕ} (gb : Fin m → Q)
    (hgen : ∀ q : Q, ∃ z : Fin m → ℤ, ∑ i, z i • gb i = q)
    (psi : Q →+ (Fin d → ℤ)) (hker : (psi.ker : Set Q).Finite) :
    ∃ A : ℕ, ∀ q : Q, ∃ z : Fin m → ℤ,
      ∑ i, z i • gb i = q ∧ ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j, |psi q j|) := by
  let Φ : (Fin m → ℤ) →ₗ[ℤ] Q := Fintype.linearCombination ℤ gb
  have hΦ : ∀ z, Φ z = ∑ i, z i • gb i := fun z => by
    simp [Φ, Fintype.linearCombination_apply]
  let P : (Fin m → ℤ) →ₗ[ℤ] (Fin d → ℤ) := psi.toIntLinearMap ∘ₗ Φ
  obtain ⟨C, hC⟩ := lattice_preimage_bound P
  choose w hw using hgen
  set B : ℤ := ∑ k ∈ hker.toFinset, l1 (w k) with hB
  have hB0 : 0 ≤ B := sum_nonneg fun _ _ => l1_nonneg _
  refine ⟨C + B.toNat, fun q => ?_⟩
  obtain ⟨z', hz'P, hz'⟩ := hC (w q)
  set k : Q := q - Φ z' with hk
  have hkker : k ∈ psi.ker := by
    rw [AddMonoidHom.mem_ker, hk, map_sub]
    have : psi (Φ z') = psi q := by
      have := hz'P
      simp only [P, LinearMap.comp_apply, AddMonoidHom.coe_toIntLinearMap] at this
      rw [this, hΦ, hw]
    rw [this, sub_self]
  have hwk : l1 (w k) ≤ B :=
    single_le_sum (f := fun k => l1 (w k)) (fun _ _ => l1_nonneg _)
      (hker.mem_toFinset.mpr hkker)
  have hPq : P (w q) = psi q := by
    simp only [P, LinearMap.comp_apply, AddMonoidHom.coe_toIntLinearMap, hΦ, hw]
  refine ⟨z' + w k, ?_, ?_⟩
  · rw [← hΦ, map_add, hΦ (w k), hw k, hk, add_sub_cancel]
  · have h1 : l1 (z' + w k) ≤ C * l1 (psi q) + B := by
      have := l1_add_le z' (w k)
      rw [hPq] at hz'
      linarith
    have hL := l1_nonneg (psi q)
    change l1 (z' + w k) ≤ _
    rw [show (1 + ∑ j, |psi q j|) = 1 + l1 (psi q) from rfl]
    push_cast
    rw [Int.toNat_of_nonneg hB0]
    have hC0 : (0 : ℤ) ≤ C := by positivity
    nlinarith

/-- `g` generating `G` modulo `H` gives integer words for every class of `G ⧸ H`. -/
lemma exists_word_of_sup_eq_top {G : Type*} [AddCommGroup G] (H : AddSubgroup G) {m : ℕ}
    (g : Fin m → G) (hgen : AddSubgroup.closure (Set.range g) ⊔ H = ⊤) (q : G ⧸ H) :
    ∃ z : Fin m → ℤ, ∑ i, z i • ((g i : G) : G ⧸ H) = q := by
  induction q using QuotientAddGroup.induction_on with
  | H x =>
    have hx : x ∈ AddSubgroup.closure (Set.range g) ⊔ H := hgen ▸ AddSubgroup.mem_top x
    obtain ⟨y, hy, h, hh, rfl⟩ := AddSubgroup.mem_sup.mp hx
    obtain ⟨a, rfl⟩ := (AddSubgroup.mem_closure_range_iff_of_fintype).mp hy
    refine ⟨a, ?_⟩
    have : ((h : G) : G ⧸ H) = 0 := (QuotientAddGroup.eq_zero_iff h).mpr hh
    simp [this]

/-- **Integer coset payment modulo a conserved-charge subgroup.** Let `g₁,…,gₘ` generate `G`
modulo `H`, and let `ψ : G ⧸ H →+ ℤ^d` have finite kernel. There is a natural constant `A`,
fixed from `G, H, g, ψ` before `x`, such that every `x : G` admits integer coefficients `z` with
`x + ∑ zᵢ • gᵢ ∈ H` and `∑ |zᵢ| ≤ A * (1 + ∑ⱼ |ψ(x + H)ⱼ|)`. -/
theorem coset_payment {G : Type*} [AddCommGroup G] (H : AddSubgroup G) {m d : ℕ}
    (g : Fin m → G) (hgen : AddSubgroup.closure (Set.range g) ⊔ H = ⊤)
    (psi : G ⧸ H →+ (Fin d → ℤ)) (hker : (psi.ker : Set (G ⧸ H)).Finite) :
    ∃ A : ℕ, ∀ x : G, ∃ z : Fin m → ℤ,
      x + ∑ i, z i • g i ∈ H ∧
        ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j, |psi (x : G ⧸ H) j|) := by
  obtain ⟨A, hA⟩ := coset_payment_abstract (fun i => ((g i : G) : G ⧸ H))
    (exists_word_of_sup_eq_top H g hgen) psi hker
  refine ⟨A, fun x => ?_⟩
  obtain ⟨z, hz, hb⟩ := hA (-(x : G ⧸ H))
  refine ⟨z, ?_, ?_⟩
  · rw [← QuotientAddGroup.eq_zero_iff]
    simp only [QuotientAddGroup.mk_add, QuotientAddGroup.mk_sum, QuotientAddGroup.mk_zsmul]
    rw [hz, add_neg_cancel]
  · have : (∑ j, |psi (-(x : G ⧸ H)) j|) = ∑ j, |psi (x : G ⧸ H) j| := by
      simp [map_neg]
    rwa [this] at hb

/-- Variant of `coset_payment` when `g₁,…,gₘ` generate `G` itself. -/
theorem coset_payment_of_generate {G : Type*} [AddCommGroup G] (H : AddSubgroup G) {m d : ℕ}
    (g : Fin m → G) (hgen : AddSubgroup.closure (Set.range g) = ⊤)
    (psi : G ⧸ H →+ (Fin d → ℤ)) (hker : (psi.ker : Set (G ⧸ H)).Finite) :
    ∃ A : ℕ, ∀ x : G, ∃ z : Fin m → ℤ,
      x + ∑ i, z i • g i ∈ H ∧
        ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j, |psi (x : G ⧸ H) j|) :=
  coset_payment H g (by rw [hgen, top_sup_eq]) psi hker

/-- **Finite family, one common constant.** For a finite family of configurations
`(G t, H t, g t, ψ t)`, each satisfying the hypotheses of `coset_payment`, there is a single
natural constant `A` that works for all of them (the sum, hence an upper bound for the maximum,
of the individual constants). -/
theorem coset_payment_family {ι : Type*} [Finite ι] (G : ι → Type*)
    [∀ t, AddCommGroup (G t)] (H : ∀ t, AddSubgroup (G t)) (m d : ι → ℕ)
    (g : ∀ t, Fin (m t) → G t) (hgen : ∀ t, AddSubgroup.closure (Set.range (g t)) ⊔ H t = ⊤)
    (psi : ∀ t, G t ⧸ H t →+ (Fin (d t) → ℤ))
    (hker : ∀ t, ((psi t).ker : Set (G t ⧸ H t)).Finite) :
    ∃ A : ℕ, ∀ t, ∀ x : G t, ∃ z : Fin (m t) → ℤ,
      x + ∑ i, z i • g t i ∈ H t ∧
        ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j, |psi t (x : G t ⧸ H t) j|) := by
  cases nonempty_fintype ι
  choose A hA using fun t => coset_payment (H t) (g t) (hgen t) (psi t) (hker t)
  refine ⟨∑ t, A t, fun t x => ?_⟩
  obtain ⟨z, hz, hb⟩ := hA t x
  refine ⟨z, hz, hb.trans ?_⟩
  have hle : (A t : ℤ) ≤ ((∑ t, A t : ℕ) : ℤ) := by
    exact_mod_cast single_le_sum (f := A) (fun _ _ => Nat.zero_le _) (mem_univ t)
  exact mul_le_mul_of_nonneg_right hle (by positivity)

/-- Nontrivial torsion with no free monitor: `G = ZMod 6`, `H = ⊥`, `g = (1)`, `d = 0`, `ψ = 0`
(kernel = all of `G ⧸ ⊥`, finite). Every `x` is paid with `∑ |zᵢ| ≤ A`. -/
theorem coset_payment_torsion_example :
    ∃ A : ℕ, ∀ x : ZMod 6, ∃ z : Fin 1 → ℤ,
      x + ∑ i, z i • (fun _ : Fin 1 => (1 : ZMod 6)) i ∈ (⊥ : AddSubgroup (ZMod 6)) ∧
        ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j : Fin 0,
          |(0 : ZMod 6 ⧸ (⊥ : AddSubgroup (ZMod 6)) →+ (Fin 0 → ℤ)) (x : ZMod 6 ⧸ ⊥) j|) := by
  refine coset_payment (⊥ : AddSubgroup (ZMod 6)) (fun _ : Fin 1 => (1 : ZMod 6))
    ?_ 0 (Set.toFinite _)
  rw [eq_top_iff]
  intro x _
  refine AddSubgroup.mem_sup_left ?_
  have : x = (x.val : ℤ) • (1 : ZMod 6) := by simp
  rw [this]
  exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self 0)) _

/-- **The finite kernel is essential.** For `G = ℤ`, `H = ⊥`, `g = (1)`, `ψ = 0 : ℤ ⧸ ⊥ → ℤ^0`
(infinite kernel), no constant `A` exists. -/
theorem not_coset_payment_infinite_kernel :
    ¬ ∃ A : ℕ, ∀ x : ℤ, ∃ z : Fin 1 → ℤ,
      x + ∑ i, z i • (fun _ : Fin 1 => (1 : ℤ)) i ∈ (⊥ : AddSubgroup ℤ) ∧
        ∑ i, |z i| ≤ (A : ℤ) * (1 + ∑ j : Fin 0,
          |(0 : ℤ ⧸ (⊥ : AddSubgroup ℤ) →+ (Fin 0 → ℤ)) (x : ℤ ⧸ ⊥) j|) := by
  rintro ⟨A, hA⟩
  obtain ⟨z, hz, hb⟩ := hA (A + 1)
  simp only [Fin.sum_univ_one, smul_eq_mul, mul_one, AddSubgroup.mem_bot,
    Finset.univ_eq_empty, Finset.sum_empty, add_zero] at hz hb
  have : z 0 = -(A + 1) := by linarith
  rw [this, abs_neg, abs_of_nonneg (by positivity)] at hb
  linarith

end S07V32
