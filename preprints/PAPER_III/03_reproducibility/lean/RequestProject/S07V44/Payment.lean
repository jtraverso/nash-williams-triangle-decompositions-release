module
public import RequestProject.S07V44.Monitor
@[expose] public section

/-!
# V44 §4 — integer payment in the ACTUAL class group, without a global coupling

No map `Qt S →+ ClassQ` is assumed.  The coordinate word produced by V34 is translated into an
actual class identity through REAL preimages of the finitely many catalog coordinates used
(`realRep`), the image identity and `CoreCompression.class_eq_iff` (via `coord_mem_H_imp_KZ`).

* `realRep C0 b` : a chosen actual preimage (`C0.q (realRep b) = b` when `b` is realizable).
* `coord_word_to_physical` : if `[q x] + ∑_{b ∈ B} z b • [b] ∈ ⟨[Dset]⟩` with `z` supported on
  realizable coordinates `Cc ⊆ B`, then `[x] + ∑_{b ∈ Cc} z b • [realRep b] ∈ K_Z` in `ClassQ`.
* `coord_mem_Kgrp_of_closure` : if the actual class `[x]` lies in the subgroup generated by the
  catalog charges `gCat v` (`v ∈ Cset`), then `[q x]` lies in the coordinate subgroup generated by
  the REALIZABLE coordinates of `Cset` (dummy entries contribute `0`).
* `physMon_payment` : from the V34 payment property, for every finite catalog set `Cset` and every
  `x ∈ M(H[W])` with `[x] ∈ ⟨gCat '' Cset⟩`, an integer word `z : Cat d R → ℤ` supported on
  realizable entries of `Cset` with `[x] + ∑ z v • gCat v ∈ K_Z` (exact, torsion included) and
  `∑ |z v| ≤ A (1 + ‖physMon x‖₁)`.
-/

open Finset Classical Submodule

noncomputable section

namespace S07V44

open TypedTriangle.SparseEdge TypedTriangle.ComponentRows TypedTriangle.Composition
open TypedTriangle.Dispersal S07V42 S07V34 S07V32

variable {V I : Type*} [Fintype V] {H : SimpleGraph V} {lab : V → I} {F : Set (Multiset I)}
  {W : Finset V} {d c E : ℕ}

/-- a chosen actual core preimage of a realizable coordinate vector (zero otherwise) -/
def realRep (C0 : CoreCompression H lab F W d c E) (b : Fin d → ℤ) : MCore H lab F W :=
  if h : Realizable C0 b then h.choose else 0

lemma q_realRep (C0 : CoreCompression H lab F W d c E) {b : Fin d → ℤ} (h : Realizable C0 b) :
    C0.q (realRep C0 b) = b := by
  unfold realRep; rw [dif_pos h]; exact h.choose_spec

lemma gCat_eq_realRep (C0 : CoreCompression H lab F W d c E) {R : ℕ} (v : Cat d R)
    (h : Realizable C0 v.1) :
    gCat C0 R v = clsQ H lab F W (realRep C0 v.1 : Sym2 V → ℤ) :=
  gCat_spec C0 v _ (q_realRep C0 h)

/-- a sum over the catalog of a function supported in `Cc ⊆ box d R` is a sum over `Cc` -/
lemma sum_cat_of_support {R : ℕ} {M : Type*} [AddCommMonoid M] {Cc : Finset (Fin d → ℤ)}
    (hCc : Cc ⊆ box d R) (f : (Fin d → ℤ) → M) (hf : ∀ b, b ∉ Cc → f b = 0) :
    ∑ v : Cat d R, f v.1 = ∑ b ∈ Cc, f b := by
  rw [Finset.sum_coe_sort (box d R) f]
  exact (sum_subset hCc fun b _ hb => hf b hb).symm

variable (C0 : CoreCompression H lab F W d c E)

/-- **coordinate word ⇒ actual class identity** (no global coupling) -/
theorem coord_word_to_physical (R : ℕ) (Z : Finset V) (x : MCore H lab F W)
    (B Cc : Finset (Fin d → ℤ)) (hCc : Cc ⊆ B) (z : (Fin d → ℤ) → ℤ)
    (hz0 : ∀ b, b ∉ Cc → z b = 0) (hreal : ∀ b ∈ Cc, Realizable C0 b)
    (h : qmk C0.S (C0.q x) + ∑ b ∈ B, z b • qmk C0.S b ∈ Hgrp C0.S (Dset C0 R Z)) :
    clsQ H lab F W (x : Sym2 V → ℤ) +
      ∑ b ∈ Cc, z b • clsQ H lab F W (realRep C0 b : Sym2 V → ℤ) ∈ KZ H lab F W Z := by
  set y : MCore H lab F W := x + ∑ b ∈ Cc, z b • realRep C0 b with hy
  have hcq : cq C0 y = qmk C0.S (C0.q x) + ∑ b ∈ B, z b • qmk C0.S b := by
    rw [hy, map_add, map_sum, cq_apply]
    rw [← sum_subset hCc (fun b _ hb => by simp [hz0 b hb])]
    congr 1
    refine sum_congr rfl fun b hb => ?_
    rw [map_zsmul, cq_apply, q_realRep C0 (hreal b hb)]
  have hK := coord_mem_H_imp_KZ C0 R Z y (by rw [← cq_apply, hcq]; exact h)
  have hcl : clsQ H lab F W (y : Sym2 V → ℤ) = clsQ H lab F W (x : Sym2 V → ℤ) +
      ∑ b ∈ Cc, z b • clsQ H lab F W (realRep C0 b : Sym2 V → ℤ) := by
    rw [← clsCore_apply, hy, map_add, map_sum, clsCore_apply]
    congr 1
  rw [← hcl]; exact hK

/-- the realizable coordinates of a finite catalog set -/
def realCoords {R : ℕ} (Cset : Finset (Cat d R)) : Finset (Fin d → ℤ) :=
  (Cset.filter fun v => Realizable C0 v.1).image Subtype.val

lemma mem_realCoords {R : ℕ} {Cset : Finset (Cat d R)} {b : Fin d → ℤ} :
    b ∈ realCoords C0 Cset ↔ ∃ v ∈ Cset, Realizable C0 v.1 ∧ v.1 = b := by
  unfold realCoords
  simp only [mem_image, mem_filter, and_assoc]

lemma realCoords_subset_box {R : ℕ} (Cset : Finset (Cat d R)) :
    realCoords C0 Cset ⊆ box d R := by
  intro b hb
  obtain ⟨v, -, -, rfl⟩ := (mem_realCoords C0).1 hb
  exact v.2

lemma realCoords_realizable {R : ℕ} {Cset : Finset (Cat d R)} {b : Fin d → ℤ}
    (hb : b ∈ realCoords C0 Cset) : Realizable C0 b := by
  obtain ⟨v, -, hv, rfl⟩ := (mem_realCoords C0).1 hb
  exact hv

lemma mem_realCoords_of_val {R : ℕ} {Cset : Finset (Cat d R)} {v : Cat d R}
    (hv : v.1 ∈ realCoords C0 Cset) : v ∈ Cset := by
  obtain ⟨u, hu, -, huv⟩ := (mem_realCoords C0).1 hv
  rwa [← Subtype.ext huv]

/-- **actual class in the catalog subgroup ⇒ coordinate class in the realizable coordinate
subgroup** (dummy entries contribute `0` and are dropped) -/
theorem coord_mem_Kgrp_of_closure {R : ℕ} (Cset : Finset (Cat d R)) (x : MCore H lab F W)
    (hx : clsQ H lab F W (x : Sym2 V → ℤ) ∈ AddSubgroup.closure (gCat C0 R '' (Cset : Set _))) :
    qmk C0.S (C0.q x) ∈ Kgrp C0.S (realCoords C0 Cset) := by
  let P : AddSubgroup (ClassQ H lab F W) :=
    ((Kgrp C0.S (realCoords C0 Cset)).comap (cq C0)).map (clsCore H lab F W)
  have hle : AddSubgroup.closure (gCat C0 R '' (Cset : Set _)) ≤ P := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨v, hv, rfl⟩
    by_cases hr : Realizable C0 v.1
    · refine ⟨realRep C0 v.1, ?_, (gCat_eq_realRep C0 v hr).symm⟩
      show cq C0 (realRep C0 v.1) ∈ Kgrp C0.S (realCoords C0 Cset)
      rw [cq_apply, q_realRep C0 hr]
      exact AddSubgroup.subset_closure ⟨v.1, Finset.mem_coe.2
        ((mem_realCoords C0).2 ⟨v, Finset.mem_coe.1 hv, hr, rfl⟩), rfl⟩
    · rw [gCat_of_not C0 v hr]
      exact zero_mem _
  obtain ⟨y, hyK, hy⟩ := hle hx
  rw [clsCore_apply, ← qmk_q_eq_iff C0] at hy
  rw [← hy]
  exact hyK

/-- **physical integer payment** from the V34 payment property of the coordinate monitor -/
theorem physMon_payment {R R0 : ℕ} (hR : R ≤ R0) (Z : Finset V) {K A : ℕ}
    (psi : Qt C0.S ⧸ Hgrp C0.S (Dset C0 R Z) →+ (Fin K → ℤ))
    (hpay : ∀ C : Finset (Fin d → ℤ), C ⊆ box d R0 → ∀ y ∈ Kgrp C0.S C,
      ∃ z : (Fin d → ℤ) → ℤ, (∀ b, b ∉ C → z b = 0) ∧
        y + ∑ b ∈ box d R0, z b • qmk C0.S b ∈ Hgrp C0.S (Dset C0 R Z) ∧
        ∑ b ∈ box d R0, |z b| ≤
          (A : ℤ) * (1 + l1 (psi (y : Qt C0.S ⧸ Hgrp C0.S (Dset C0 R Z)))))
    (Cset : Finset (Cat d R)) (x : MCore H lab F W)
    (hx : clsQ H lab F W (x : Sym2 V → ℤ) ∈ AddSubgroup.closure (gCat C0 R '' (Cset : Set _))) :
    ∃ z : Cat d R → ℤ, (∀ v, v ∉ Cset → z v = 0) ∧ (∀ v, z v ≠ 0 → Realizable C0 v.1) ∧
      clsQ H lab F W (x : Sym2 V → ℤ) + ∑ v, z v • gCat C0 R v ∈ KZ H lab F W Z ∧
      ∑ v, |z v| ≤ (A : ℤ) * (1 + l1 (physMon C0 (Dset C0 R Z) psi x)) := by
  set Cc := realCoords C0 Cset with hCcdef
  have hCcR : Cc ⊆ box d R := realCoords_subset_box C0 Cset
  have hCc0 : Cc ⊆ box d R0 := hCcR.trans (box_mono hR)
  obtain ⟨z, hz0, hzH, hzc⟩ := hpay Cc hCc0 _ (coord_mem_Kgrp_of_closure C0 Cset x hx)
  have hphys := coord_word_to_physical C0 R Z x (box d R0) Cc hCc0 z hz0
    (fun b hb => realCoords_realizable C0 hb) hzH
  -- sums over the catalog reduce to sums over `Cc`
  refine ⟨fun v => z v.1, ?_, ?_, ?_, ?_⟩
  · intro v hv
    refine hz0 _ fun hvC => hv ?_
    exact mem_realCoords_of_val C0 hvC
  · intro v hv
    by_contra hr
    exact hv (hz0 _ fun hvC => hr (realCoords_realizable C0 hvC))
  · have hterm : ∀ v : Cat d R, z v.1 • gCat C0 R v =
        z v.1 • clsQ H lab F W (realRep C0 v.1 : Sym2 V → ℤ) := by
      intro v
      by_cases hv : v.1 ∈ Cc
      · rw [gCat_eq_realRep C0 v (realCoords_realizable C0 hv)]
      · rw [hz0 _ hv, zero_smul, zero_smul]
    have : ∑ v : Cat d R, z v.1 • gCat C0 R v =
        ∑ b ∈ Cc, z b • clsQ H lab F W (realRep C0 b : Sym2 V → ℤ) := by
      rw [Finset.sum_congr rfl fun v _ => hterm v]
      exact sum_cat_of_support hCcR (fun b => z b • clsQ H lab F W (realRep C0 b : Sym2 V → ℤ))
        (fun b hb => by simp [hz0 b hb])
    rw [this]; exact hphys
  · have h1 : ∑ v : Cat d R, |z v.1| = ∑ b ∈ Cc, |z b| :=
      sum_cat_of_support hCcR (fun b => |z b|) (fun b hb => by simp [hz0 b hb])
    have h2 : ∑ b ∈ box d R0, |z b| = ∑ b ∈ Cc, |z b| :=
      (sum_subset hCc0 fun b _ hb => by rw [hz0 b hb, abs_zero]).symm
    rw [h1, ← h2]
    exact hzc

end S07V44
