module
public import RequestProject.TypedTriangle.SparseEdgeHost
public import RequestProject.TypedTriangle.Packing
@[expose] public section

/-! Entry of a sparse physical deletion into the ACTUAL residual integer lattice.
H2 of the host and physicality of the deleted edges are both used. Neither an
arbitrary deletion nor the hinge geometry of the residual is asserted. -/

open Finset Classical
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace TypedTriangle.Residual
variable {V I : Type*} [Fintype V]

lemma edges_subHost_eq {H : Host V I} {J : Finset (Sym2 V)} (hJ : J ⊆ edges H) :
    edges (subHost H J) = J := by
  ext e
  induction e using Sym2.ind with
  | _ u v =>
    have hsup : s(u,v) ∈ J → H.G.Adj u v := by
      intro he
      simpa [edges] using hJ he
    simp only [edges,mem_filter,mem_univ,true_and,subHost,SimpleGraph.mem_edgeSet,
      SimpleGraph.inf_adj,SimpleGraph.fromEdgeSet_adj,Finset.mem_coe]
    constructor
    · rintro ⟨⟨he,-⟩,-⟩; exact he
    · intro he
      exact ⟨⟨he,(hsup he).ne⟩,hsup he⟩

lemma commonNbrs_sdiff {H : Host V I} (B : Finset (Sym2 V)) (k : I) (u v : V) :
    commonNbrs (subHost H (edges H \ B)) k u v =
      (commonNbrs H k u v).filter (fun w => s(u,w) ∉ B ∧ s(v,w) ∉ B) := by
  ext w
  simp only [commonNbrs,mem_filter,mem_univ,true_and,subHost,
    SimpleGraph.inf_adj,SimpleGraph.fromEdgeSet_adj,mem_sdiff,edges,
    SimpleGraph.mem_edgeSet,Finset.mem_coe]
  constructor
  · rintro ⟨⟨⟨⟨hu,hBu⟩,hun⟩,hu'⟩,⟨⟨⟨hv,hBv⟩,hvn⟩,hv'⟩,hlab⟩
    exact ⟨⟨hu',hv',hlab⟩,hBu,hBv⟩
  · rintro ⟨⟨hu,hv,hlab⟩,hBu,hBv⟩
    exact ⟨⟨⟨⟨hu,hBu⟩,hu.ne⟩,hu⟩,⟨⟨⟨hv,hBv⟩,hv.ne⟩,hv⟩,hlab⟩

/-- Common-neighbour losses are paid locally by the two endpoint degrees. -/
theorem commonNbrCond_sdiff {H : Host V I} {F : Set (Multiset I)} {α : ℝ}
    (hH3 : CommonNbrCond H F α) (B : Finset (Sym2 V)) (d : ℕ)
    (hdeg : ∀ v, (B.filter (fun e => v ∈ e)).card ≤ d)
    (hwindow : (4*d : ℕ) ≤ α * Fintype.card V) :
    CommonNbrCond (subHost H (edges H \ B)) F (α/2) := by
  intro u v huv k htype
  have hfull := hH3 u v huv k htype
  let bad := SparseEdge.nbrIn B u ∪ SparseEdge.nbrIn B v
  have hbad : bad.card ≤ 2*d :=
    (card_union_le _ _).trans (by
      have hu := (SparseEdge.card_nbrIn_le B u).trans (hdeg u)
      have hv := (SparseEdge.card_nbrIn_le B v).trans (hdeg v)
      omega)
  have hcover : commonNbrs H k u v ⊆
      commonNbrs (subHost H (edges H \ B)) k u v ∪ bad := by
    intro w hw
    by_cases hBu : s(u,w) ∈ B
    · exact mem_union_right _ (mem_union_left _ (by simp [SparseEdge.nbrIn,hBu]))
    by_cases hBv : s(v,w) ∈ B
    · exact mem_union_right _ (mem_union_right _ (by simp [SparseEdge.nbrIn,hBv]))
    · exact mem_union_left _ (by rw [commonNbrs_sdiff]; exact mem_filter.mpr ⟨hw,hBu,hBv⟩)
  have hc := (card_le_card hcover).trans (card_union_le _ _)
  have hcR : ((commonNbrs H k u v).card : ℝ) ≤
      (commonNbrs (subHost H (edges H \ B)) k u v).card + bad.card := by exact_mod_cast hc
  have hbR : (bad.card : ℝ) ≤ 2*d := by exact_mod_cast hbad
  change α/2 * Fintype.card V ≤ _
  push_cast at hwindow
  nlinarith

/-- Uniform physical entry after a sparse physical deletion. The target lies in
the integer lattice generated by triangles INSIDE the residual host. -/
theorem physical_residual_of_H2H3H4 (α : ℝ) (h : ℕ) (hα : 0 < α) :
    ∃ η : ℝ, 0 < η ∧ ∃ n₀ : ℕ,
      ∀ {V I : Type} [Fintype V] (H : Host V I) (F : Set (Multiset I)),
        n₀ ≤ Fintype.card V → CommonNbrCond H F α → HingeCond H F α h →
        IsPhysical H F (edges H) →
        ∀ B : Finset (Sym2 V), B ⊆ edges H → IsPhysical H F B →
          (∀ v, ((B.filter (fun e => v ∈ e)).card : ℝ) ≤ η * Fintype.card V) →
          IsPhysical (subHost H (edges H \ B)) F (edges (subHost H (edges H \ B))) := by
  obtain ⟨η,hη,n₀,hdel⟩ := sparse_edge_deletion_host α h hα
  refine ⟨η,hη,n₀,?_⟩
  intro V I _ H F hn hH3 hH4 hH2 B hBH hB hdeg
  have hphys := isPhysical_sdiff hH2 hB hBH
  have hzero : ∀ e ∈ B, ind (edges H \ B) e = 0 := by intro e he; simp [ind,he]
  have hentry := (hdel V I H F hn hH3 hH4 B hdeg (ind (edges H \ B))).mpr ⟨hphys,hzero⟩
  change ind (edges (subHost H (edges H \ B))) ∈ _
  rw [edges_subHost_eq sdiff_subset]
  exact hentry

/-- In particular, deleting any sufficiently sparse allowed packing preserves
H2 in the residual host itself, not only in the original ambient lattice. -/
theorem physical_residual_of_packing (α : ℝ) (h : ℕ) (hα : 0 < α) :
    ∃ η : ℝ, 0 < η ∧ ∃ n₀ : ℕ,
      ∀ {V I : Type} [Fintype V] (H : Host V I) (F : Set (Multiset I)),
        n₀ ≤ Fintype.card V → CommonNbrCond H F α → HingeCond H F α h →
        IsPhysical H F (edges H) →
        ∀ P : Finset (Finset V), IsPacking H F P →
          (∀ v, (((P.biUnion triEdges).filter (fun e => v ∈ e)).card : ℝ) ≤
            η * Fintype.card V) →
          IsPhysical (subHost H (edges H \ P.biUnion triEdges)) F
            (edges (subHost H (edges H \ P.biUnion triEdges))) := by
  obtain ⟨η,hη,n₀,hmain⟩ := physical_residual_of_H2H3H4 α h hα
  refine ⟨η,hη,n₀,?_⟩
  intro V I _ H F hn hH3 hH4 hH2 P hP hdeg
  have hB : P.biUnion triEdges ⊆ edges H := by
    intro e he
    obtain ⟨T,hT,heT⟩ := mem_biUnion.mp he
    exact triEdges_subset_edges (hP.1 T hT) heT
  exact hmain H F hn hH3 hH4 hH2 _ hB
    (isPhysical_of_isDecomposition hP.isDecomposition) hdeg

end TypedTriangle.Residual
